[Desktop Entry]
Version=1.0
Type=Application
Name=Claude Privacy Check
Comment=Check whether your organisation is capturing Claude Code prompts
Comment[de]=Prüft, ob die Organisation Claude Code mitschneidet
# %k is the path of this file, so the program beside it is the one that starts -- wherever the
# folder was copied to. The same path repairs Icon= in place: a .desktop file cannot point at its
# icon with a relative path (the spec reads one as a theme name), so the launcher writes the
# absolute path of the icon next to it whenever the folder has moved.
Exec=/bin/bash -c "s=\\$(readlink -f \\"\\$0\\"); d=\\${s%%/*}; i=\\$d/claude_privacy_check/icons/claude-privacy-check.svg; grep -qxF \\"Icon=\\$i\\" \\"\\$s\\" || { I=\\$i awk '/^Icon=/{print \\"Icon=\\" ENVIRON[\\"I\\"]; next}1' \\"\\$s\\" > \\"\\$s.new\\" && mv -f \\"\\$s.new\\" \\"\\$s\\"; }; cd \\"\\$d\\" && exec python3 ./run.py" %k
Icon=/home/joruf/Applications/claude-privacy-check/claude_privacy_check/icons/claude-privacy-check.svg
Terminal=false
Categories=System;Security;
Keywords=Claude;Privacy;Monitoring;Telemetry;
Keywords[de]=Claude;Datenschutz;Überwachung;Telemetrie;
StartupWMClass=claude-privacy-check
